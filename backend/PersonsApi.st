'From Pharo13.1.0SNAPSHOT of 23 September 2026 [Build information: Pharo-13.1.0+SNAPSHOT.build.749.sha.d7c6f761d5445e8b04a0aa5137e0d546ad9bcd89 (64 Bit)] on 9 October 2026 at 2:08:23.820894 pm'!Object subclass: #PersonsApi	instanceVariableNames: 'server'	classVariableNames: ''	package: 'New'!!PersonsApi methodsFor: 'accessing' stamp: '2026-10-08T22:13:51.437665+02:00'!start    server := ZnServer startDefaultOn: 8081.    server delegate: ZnDispatcherDelegate new.    server delegate        map: '/api/persons'        to: [ :request :response |            response entity: (                ZnEntity                    with: (                        NeoJSONWriter toString: (                            (PersonsRepository new people)                                collect: [ :person | person asDictionary ]                        )                    )                    type: ZnMimeType applicationJson            )        ]! !!PersonsApi methodsFor: 'accessing' stamp: '2026-10-08T22:14:58.212048+02:00'!stop    server ifNotNil: [        server stop.        server := nil    ].    ^ self! !